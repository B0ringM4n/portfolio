---
interface Props {
  href: string;
  label: string;
  external?: boolean;
  class?: string;
}

const { href, label, external = false, class: className } = Astro.props;
---

<a
  class:list={['text-link', className]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
>
  <span>{label}</span><span class="text-link__arrow" aria-hidden="true">→</span>
</a>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';

type Project = CollectionEntry<'projects'>;
type GalleryItem = Project['data']['gallery'][number] & { image: ImageMetadata };

interface Props {
  gallery: Project['data']['gallery'];
}

const { gallery } = Astro.props;
const galleryItems = gallery as GalleryItem[];
---

<section class="gallery project-frame" aria-labelledby="project-gallery-title">
  <h2 id="project-gallery-title" class="project-kicker">Galería del proyecto</h2>
  <div class="gallery__grid">
    {
      galleryItems.map(({ image, alt, caption, layout }) => (
        <figure class:list={['gallery__item', `gallery__item--${layout}`]} data-gallery-item>
          <Image
            src={image}
            alt={alt}
            widths={[480, 768, 1080, 1600]}
            sizes={
              layout === 'wide'
                ? '(max-width: 699px) calc(100vw - 2rem), (max-width: 1439px) calc(100vw - 5rem), 1400px'
                : '(max-width: 699px) calc(100vw - 2rem), (max-width: 1439px) calc((100vw - 6.5rem) / 2), 688px'
            }
            loading="lazy"
          />
          {caption && <figcaption>{caption}</figcaption>}
        </figure>
      ))
    }
  </div>
</section>

---
import type { SiteData } from '@/types/site';

interface Props {
  contact: SiteData['contact'];
}

const { contact } = Astro.props;
---

<section id="contact" class="contact-section" aria-labelledby="contact-title" data-menu-background>
  <div class="home-frame contact-section__grid">
    <h2 id="contact-title">
      {
        contact.lines.map((line) => (
          <span class="contact-section__line-mask">
            <span data-reveal>{line}</span>
          </span>
        ))
      }
    </h2>
    <a class="contact-section__email" href={`mailto:${contact.email}`} data-magnetic>{contact.email}</a>
  </div>
</section>

{
  "name": "editorial-portfolio",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "build": "astro build",
    "capture:visual": "env -u NO_COLOR -u FORCE_COLOR node scripts/capture-visual-audit.mjs",
    "test": "vitest run",
    "test:output": "node --test tests/*.test.mjs",
    "test:e2e": "npm run build && env -u NO_COLOR -u FORCE_COLOR playwright test",
    "verify:production": "node scripts/verify-production.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:output && npm run verify:production"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "latest",
    "astro": "7.2.2",
    "gsap": "latest",
    "lenis": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "sharp": "latest",
    "typescript": "^6.0.0",
    "vitest": "latest"
  }
}

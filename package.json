{
  "name": "editorial-portfolio",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "test": "vitest run",
    "test:e2e": "env -u NO_COLOR -u FORCE_COLOR playwright test",

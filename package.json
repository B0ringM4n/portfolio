  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "latest",
    "astro": "7.2.2",
    "gsap": "latest",
    "lenis": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@types/node": "latest",
    "@playwright/test": "latest",
    "sharp": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
